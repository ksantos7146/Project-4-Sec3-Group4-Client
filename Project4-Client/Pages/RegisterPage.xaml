<Page x:Class="Project4_Client.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF5F7"
      MinWidth="800"
      MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Viewbox Grid.Row="0" MaxHeight="200" Margin="0,40,0,30">
            <Image Source="/Project4-Client;component/Resources/logo.png" Stretch="Uniform"/>
        </Viewbox>

        <!-- Register Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Disabled"
                     Margin="0,0,0,20">
            <Grid MaxWidth="800">
                <Border Background="White" CornerRadius="10" 
                        HorizontalAlignment="Center" 
                        BorderBrush="#FF4081" BorderThickness="1"
                        MinWidth="500" MaxWidth="700"
                        Margin="20,0,20,0">
                    <StackPanel Margin="40,20">
                        <TextBlock Text="Join the Commit 💘" 
                                 FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}" 
                                 FontWeight="Bold" Foreground="#FF4081" 
                                 HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <TextBlock Text="Username" Margin="0,5,0,0"/>
                        <TextBox x:Name="UsernameTextBox" MinHeight="35" 
                                Margin="0,0,0,10" Padding="10"/>

                        <TextBlock Text="Email" Margin="0,5,0,0"/>
                        <TextBox x:Name="EmailTextBox" MinHeight="35" 
                                Margin="0,0,0,10" Padding="10"/>

                        <TextBlock Text="Password" Margin="0,5,0,0"/>
                        <PasswordBox x:Name="PasswordBox" MinHeight="35" 
                                   Margin="0,0,0,10" Padding="10"/>

                        <TextBlock Text="Confirm Password" Margin="0,5,0,0"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" MinHeight="35" 
                                   Margin="0,0,0,10" Padding="10"/>

                        <TextBlock Text="Bio (Optional)" Margin="0,5,0,0"/>
                        <TextBox x:Name="BioTextBox" MinHeight="80" 
                                Margin="0,0,0,10" Padding="10" 
                                TextWrapping="Wrap" AcceptsReturn="True"/>

                        <TextBlock Text="Gender" Margin="0,5,0,0"/>
                        <ComboBox x:Name="GenderComboBox" MinHeight="35" 
                                 Margin="0,0,0,10" Padding="10">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Age" Margin="0,5,0,0"/>
                        <TextBox x:Name="AgeTextBox" MinHeight="35" 
                                Margin="0,0,0,10" Padding="10"/>

                        <Button Content="Register" Background="#FF4081" 
                                Foreground="White" MinHeight="40"
                                Margin="0,20,0,10" Padding="10"
                                Click="Register_Click"/>

                        <TextBlock Text="Already have an account?" 
                                 HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Button Content="Login" Background="Transparent" 
                                Foreground="#FF4081" Click="GoToLogin_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
