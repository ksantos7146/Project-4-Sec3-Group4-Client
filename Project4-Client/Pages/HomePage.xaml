<Page x:Class="Project4_Client.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF5F7"
      MinWidth="800"
      MinHeight="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Top Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="AccountButton" Content="Account" Width="80" Height="30" Background="#FF4081" Foreground="White" 
                    Click="AccountButton_Click"/>
            <Button x:Name="MatchesButton" Content="Matches" Width="80" Height="30" Background="#FF4081" Foreground="White" 
                    Margin="10,0,0,0" Click="MatchesButton_Click"/>
            <Button x:Name="PreferencesButton" Content="Preferences" Width="80" Height="30" 
                    Background="#FF4081" Foreground="White" Margin="10,0,0,0" 
                    Click="PreferencesButton_Click"/>
        </StackPanel>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Skip Button -->
            <Button x:Name="SkipButton" Grid.Column="0" Content="Skip" Width="100" Height="40" Background="#FF4081" 
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SkipButton_Click"/>

            <!-- About Me Panel -->
            <Border Grid.Column="1" BorderBrush="#FF4081" BorderThickness="1" Margin="10" CornerRadius="10">
                <StackPanel Margin="20">
                    <TextBlock Text="About Me" FontSize="24" FontWeight="Bold" Foreground="#FF4081" Margin="0,0,0,20"/>
                    <TextBlock x:Name="NameTextBlock" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="AgeTextBlock" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="BioTextBlock" FontSize="16" Margin="0,5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Profile Image Area -->
            <Border Grid.Column="2" BorderBrush="#FF4081" BorderThickness="2" CornerRadius="10" Margin="10">
                <Grid Background="White">
                    <Image x:Name="ProfileImage" Stretch="Uniform" Margin="20"/>
                </Grid>
            </Border>

            <!-- Like Button -->
            <Button x:Name="LikeButton" Grid.Column="3" Content="Like" Width="100" Height="40" Background="#FF4081" 
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Click="LikeButton_Click"/>
        </Grid>
    </Grid>
</Page>
