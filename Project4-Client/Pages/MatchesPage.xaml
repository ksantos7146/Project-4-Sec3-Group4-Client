<Page x:Class="Project4_Client.Pages.MatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF5F7"
      MinWidth="800"
      MinHeight="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button x:Name="BackButton" Content="Back" Width="80" Height="30" Background="#FF4081" Foreground="White" 
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10" Click="BackButton_Click"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.33*"/>
                <ColumnDefinition Width="0.67*"/>
            </Grid.ColumnDefinitions>

            <!-- Matches List -->
            <Border Grid.Column="0" BorderBrush="#FF4081" BorderThickness="1" Margin="0,0,5,0">
                <ListView x:Name="MatchesListView" Background="White" SelectionChanged="MatchesListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <Border Width="50" Height="50" CornerRadius="25" BorderBrush="#FF4081" BorderThickness="1">
                                    <Image Source="{Binding ProfileImage}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Match Details -->
            <Border Grid.Column="1" BorderBrush="#FF4081" BorderThickness="1" Margin="5,0,0,0">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Profile Image -->
                    <Border Grid.Row="0" Height="300" Margin="20" BorderBrush="#FF4081" BorderThickness="1" CornerRadius="10">
                        <Image x:Name="MatchProfileImage" Stretch="UniformToFill"/>
                    </Border>

                    <!-- User Info -->
                    <StackPanel Grid.Row="1" Margin="20">
                        <TextBlock x:Name="MatchNameText" FontSize="24" FontWeight="Bold" Foreground="#FF4081"/>
                        <TextBlock x:Name="MatchEmailText" FontSize="16" Margin="0,5,0,0" Foreground="Gray"/>
                        <TextBlock x:Name="MatchAgeText" FontSize="18" Margin="0,10,0,0"/>
                        <TextBlock x:Name="MatchBioText" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page> 