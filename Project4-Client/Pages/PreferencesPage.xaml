<Page x:Class="Project4_Client.Pages.PreferencesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#FFF5F7"
      MinWidth="800"
      MinHeight="600"
      Title="PreferencesPage">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="800">
                <Border Background="White" CornerRadius="10"
                        HorizontalAlignment="Center"
                        BorderBrush="#FF4081" BorderThickness="1"
                        MinWidth="500" MaxWidth="700"
                        Margin="20">
                    <StackPanel Margin="40,20">
                        <TextBlock Text="Dating Preferences" 
                                 FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
                                 FontWeight="Bold" Foreground="#FF4081"
                                 HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <!-- Age Range -->
                        <TextBlock Text="Age Range" FontWeight="SemiBold" Margin="0,5,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum Age (18-99)" Margin="0,0,0,5"/>
                                <TextBox x:Name="MinAgeTextBox" MinHeight="35"
                                        Padding="10" Text="18"
                                        PreviewTextInput="NumberValidationTextBox"
                                        TextChanged="AgeTextBox_TextChanged"/>
                                <TextBlock x:Name="MinAgeError" Foreground="Red" 
                                         TextWrapping="Wrap" Margin="0,5,0,0"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock Text="-" Grid.Column="1" 
                                     VerticalAlignment="Bottom" 
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,10"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Maximum Age (18-99)" Margin="0,0,0,5"/>
                                <TextBox x:Name="MaxAgeTextBox" MinHeight="35"
                                        Padding="10" Text="99"
                                        PreviewTextInput="NumberValidationTextBox"
                                        TextChanged="AgeTextBox_TextChanged"/>
                                <TextBlock x:Name="MaxAgeError" Foreground="Red" 
                                         TextWrapping="Wrap" Margin="0,5,0,0"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Gender Preference -->
                        <TextBlock Text="Interested In" FontWeight="SemiBold" Margin="0,20,0,5"/>
                        <ComboBox x:Name="GenderPreferenceComboBox" MinHeight="35"
                                 Margin="0,0,0,10" Padding="10">
                            <ComboBoxItem Content="Everyone"/>
                            <ComboBoxItem Content="Men"/>
                            <ComboBoxItem Content="Women"/>
                        </ComboBox>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                  Margin="0,30,0,10">
                            <Button x:Name="SaveButton" Content="Save Preferences" 
                                    Background="#FF4081" Foreground="White" 
                                    MinHeight="40" MinWidth="120" 
                                    Margin="0,0,10,0" Padding="20,10" 
                                    Click="SaveButton_Click"/>
                            <Button Content="Back" Background="Transparent"
                                    Foreground="#FF4081" MinHeight="40"
                                    MinWidth="120" Padding="20,10" 
                                    Click="BackButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page> 