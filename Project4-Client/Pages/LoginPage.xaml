<Page x:Class="Project4_Client.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF5F7"
      MinWidth="800"
      MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Viewbox Grid.Row="0" MaxHeight="200" Margin="0,40,0,30">
            <Image Source="/Project4-Client;component/Resources/logo.png" Stretch="Uniform"/>
        </Viewbox>

        <!-- Login Form -->
        <Grid Grid.Row="1" MaxWidth="600">
            <Border Background="White" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    BorderBrush="#FF4081" BorderThickness="1" 
                    MinWidth="400" MaxWidth="500"
                    Margin="20,0,20,20">
                <StackPanel Margin="40,20">
                    <TextBlock Text="Welcome Back 💖" FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}" 
                             FontWeight="Bold" Foreground="#FF4081" 
                             HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    
                    <TextBlock Text="Username" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameTextBox" MinHeight="35" Margin="0,0,0,20"
                            Padding="5"/>
                    
                    <TextBlock Text="Password" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" MinHeight="35" Margin="0,0,0,30"
                               Padding="5"/>
                    
                    <Button Content="Login" MinHeight="40"
                            Background="#FF4081" Foreground="White"
                            Click="Login_Click" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Don't have an account?" 
                             HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Button Content="Register" Background="Transparent" 
                            Foreground="#FF4081" Click="GoToRegister_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
