<Page x:Class="Project4_Client.Pages.AccountInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#FFF5F7"
      MinWidth="800"
      MinHeight="600"
      Title="AccountInfo">
    <Grid>
        <!-- Account Info Form -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="800">
                <Border Background="White" CornerRadius="10"
                        HorizontalAlignment="Center"
                        BorderBrush="#FF4081" BorderThickness="1"
                        MinWidth="500" MaxWidth="700"
                        Margin="20">
                    <StackPanel Margin="40,20">
                        <TextBlock Text="Edit Your Profile" 
                                 FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
                                 FontWeight="Bold" Foreground="#FF4081"
                                 HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <!-- Profile Image Section -->
                        <Border Width="200" Height="200" 
                                BorderBrush="#FF4081" BorderThickness="1" 
                                CornerRadius="100"
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Grid>
                                <Viewbox>
                                    <Image x:Name="ProfileImage" Stretch="UniformToFill"/>
                                </Viewbox>
                                <Button x:Name="UploadImageButton" Content="Change Picture"
                                        Click="UploadImageButton_Click"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="#FF4081" Foreground="White"
                                        Margin="0,0,0,20"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Email" Margin="0,5,0,0"/>
                        <TextBox x:Name="EmailTextBox" MinHeight="35"
                                Margin="0,0,0,10" Padding="10"/>

                        <TextBlock Text="Bio" Margin="0,5,0,0"/>
                        <TextBox x:Name="BioTextBox" MinHeight="80"
                                Margin="0,0,0,10" Padding="10"
                                TextWrapping="Wrap" AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Gender" Margin="0,5,0,0"/>
                        <ComboBox x:Name="GenderComboBox" MinHeight="35"
                                 Margin="0,0,0,10" Padding="10">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Age" Margin="0,5,0,0"/>
                        <TextBox x:Name="AgeTextBox" MinHeight="35"
                                Margin="0,0,0,10" Padding="10"/>

                        <TextBlock Text="New Password (leave empty to keep current)" 
                                 Margin="0,5,0,0"/>
                        <PasswordBox x:Name="PasswordBox" MinHeight="35"
                                   Margin="0,0,0,10" Padding="10"/>

                        <TextBlock Text="Confirm New Password" Margin="0,5,0,0"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" MinHeight="35"
                                   Margin="0,0,0,10" Padding="10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                  Margin="0,20,0,10">
                            <Button Content="Save Changes" Background="#FF4081" 
                                    Foreground="White" MinHeight="40"
                                    MinWidth="120" Margin="0,0,10,0" 
                                    Padding="20,10" Click="SaveButton_Click"/>
                            <Button Content="Cancel" Background="Transparent"
                                    Foreground="#FF4081" MinHeight="40"
                                    MinWidth="120" Padding="20,10" 
                                    Click="CancelButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
